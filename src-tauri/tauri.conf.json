{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Password Saver",
  "version": "0.1.0",
  "identifier": "com.emilnordstroem.passwordsaver",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Password Saver",
        "width": 700,
        "height": 500,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/icon.svg",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15",
      "hardenedRuntime": true
    }
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/emilnordstroem/password-saver/releases"],
      "pubkey": ""
    }
  }
}
